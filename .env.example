# Needed for the terminal chat (npm run chat) and any server you put in front of agent/accre-agent.js.
# The web demo never needs a key.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional model tuning
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# Optional integrations: JSON is POSTed here on capture_lead / escalate_to_human.
# Leave blank to keep leads in the local inbox.
LEAD_WEBHOOK_URL=
HANDOFF_WEBHOOK_URL=
WEBHOOK_SECRET=
